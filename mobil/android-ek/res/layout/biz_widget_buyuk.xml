<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran widget'ı 4×2, dikey ekran: adlar, "N gündür birlikteyiz", buluşma geri sayımı.
     BizWidget.java doldurur (RemoteViews: yalnız izinli görünümler). Varsayılan metinler seçici önizlemesidir. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/biz_widget_zemin"
    android:clipToOutline="true"
    android:contentDescription="@string/biz_widget_baslik"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/biz_widget_adlar_satir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/biz_widget_kalp" />

            <TextView
                android:id="@+id/biz_widget_adlar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/biz_widget_baslik"
                android:textColor="@color/biz_widget_soluk"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/biz_widget_sayi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:text="@string/biz_widget_ornek_sayi"
                android:textColor="@color/biz_widget_vurgu"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/biz_widget_etiket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="@string/biz_widget_gundur"
                android:textColor="@color/biz_widget_yazi"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/biz_widget_bulusma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/biz_widget_hap"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/biz_widget_hap_yazi"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
